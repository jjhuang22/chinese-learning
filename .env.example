# Vercel Production: base URL, without /rest/v1/ or /auth/v1/.
NEXT_PUBLIC_SUPABASE_URL=
# Sensitive: server-only service-role key, never a publishable/anon key.
SUPABASE_SERVICE_ROLE_KEY=
# Existing Authentication user UUID that already owns your lessons/cards.
LEARNER_USER_ID=
# Sensitive: choose a private passcode of 8–128 characters. Never use NEXT_PUBLIC_.
APP_PASSCODE=
