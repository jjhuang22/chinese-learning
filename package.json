{
  "name": "everyday-chinese",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:privacy": "node scripts/test-privacy.mjs",
    "test:database": "playwright test --config=playwright.database.config.ts",
    "test:passcode": "playwright test --config=playwright.passcode.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm run typecheck && npm run test:database && npm test && npm run test:privacy && npm run test:passcode",
    "import:lessons": "node --env-file=.env.local --experimental-strip-types scripts/import-lessons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pinyin-pro": "^3.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
